<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Package version, used by the library and by the analyzer shipped in it. AssemblyVersion and FileVersion follow it
    (2.0.1.0); the analyzer assembly changes identity with every package version.
  -->
  <PropertyGroup>
    <HecoleMediatorVersion>2.0.1</HecoleMediatorVersion>
  </PropertyGroup>

</Project>
