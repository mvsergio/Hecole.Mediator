  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hecole.Mediator.Tests.ScanTarget\Hecole.Mediator.Tests.ScanTarget.csproj" />
    <!-- The analyzer shipped in the package, loaded the way a consumer of the package gets it. -->
    <ProjectReference Include="..\..\src\Hecole.Mediator.Analyzers\Hecole.Mediator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
